Usage Example
python
import cv2
from backend.model_loader import load_spillguard_model
from backend.prediction import preprocess_image, postprocess_prediction, calculate_spill_percentage, determine_risk_level

# Load model
model, loaded = load_spillguard_model('AI_SpillGuard_v1_final_CORRECTED.keras')

# Read image
image = cv2.imread('satellite_image.jpg')
image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

# Preprocess
img_batch, img_resized = preprocess_image(image_rgb)

# Predict
prediction = model.predict(img_batch)
prob_map, binary_mask = postprocess_prediction(prediction, threshold=0.5)

# Get results
spill_pct = calculate_spill_percentage(binary_mask)
risk_msg, risk_level = determine_risk_level(spill_pct)

print(f"Spill: {spill_pct:.2f}%")
print(f"Risk: {risk_msg}")
